# Shared Supabase project (publishable key is safe for browser use).
# Keep the service-role key server-only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Journal publishing platform (server-only secrets, shared with the dashboard)
# HMAC secret for signed /journal/preview/[token] links; must match the
# dashboard's JOURNAL_PREVIEW_SECRET.
JOURNAL_PREVIEW_SECRET=
# Bearer secret the dashboard sends to POST /api/journal/revalidate.
JOURNAL_REVALIDATE_SECRET=
# Journal data source during cutover: merge (default) | supabase | hardcoded.
JOURNAL_SOURCE=merge

# Public analytics configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
NEXT_PUBLIC_POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX

# Optional server-side Slack alerts for selected conversion events
SLACK_ANALYTICS_WEBHOOK_URL=
SLACK_ANALYTICS_ALERT_EVENTS=assessment_submitted,clinic_application_submitted,contact_submitted
SLACK_ANALYTICS_COOLDOWN_SECONDS=300
