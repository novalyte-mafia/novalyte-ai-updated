# Shared Supabase project (publishable key is safe for browser use).
# Keep the service-role key server-only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Journal publishing platform (server-only secrets, shared with the dashboard)
# HMAC secret for signed /journal/preview/[token] links; must match the
# dashboard's JOURNAL_PREVIEW_SECRET.
JOURNAL_PREVIEW_SECRET=
# Bearer secret the dashboard sends to POST /api/journal/revalidate.
JOURNAL_REVALIDATE_SECRET=
# Journal data source during cutover: merge (default) | supabase | hardcoded.
JOURNAL_SOURCE=merge

# Public analytics configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
NEXT_PUBLIC_POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX

# Unified form notifications (server-only)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=admin@novalyte.io
ADMIN_NOTIFICATION_BCC_EMAIL=jamil@novalyte.io
NOTIFICATION_FROM_EMAIL=Novalyte AI <notifications@novalyte.io>
SLACK_FORM_WEBHOOK_URL=
ADMIN_DASHBOARD_URL=https://admin.novalyte.io
FORM_NOTIFICATION_CRON_SECRET=

# Investor portal (investor.novalyte.io)
NEXT_PUBLIC_INVESTOR_SITE_URL=https://investor.novalyte.io
INVESTOR_ACCESS_CODE=1750-44
INVESTOR_GATE_SECRET=
INVESTOR_NOTIFY_EMAIL=admin@novalyte.io
# Legacy CONTACT_* / specialized Slack variables remain supported during rollout:
# CONTACT_RATE_LIMIT_SECRET=
# SLACK_INVESTOR_WEBHOOK_URL=
# SLACK_CONTACT_WEBHOOK_URL=
